# Nginx site for the recovered frontend + Node backend.
# Replace YOUR_DOMAIN before enabling. This is a complete HTTP example only;
# add your existing TLS/Certbot directives or adapt it to your existing server.
server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;

    root /var/www/zaytouna/frontend_reconstructed/build;
    index index.html;
    client_max_body_size 25m;

    # Keep /api in the URL. The frontend calls relative same-origin /api/* paths,
    # so browser session cookies remain same-origin and no frontend API URL is built in.
    location = /api {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_read_timeout 75s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed JS/CSS assets may be cached. index.html is not cached so a new
    # deployment immediately points browsers to its new hashed files.
    location ^~ /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    location ~ /\. {
        deny all;
    }
}
